# Copy to backend/.env.extraction and fill both values locally.
# Load explicitly with: python -m app.extraction --env-file .env.extraction ...
EXTRACTION_PROVIDER=verda
# Exact enabled model ID from your Verda project.
EXTRACTION_MODEL=
# Your Verda inference API key. Keep the populated file out of Git.
EXTRACTION_API_KEY=

# --- Suggested settings for Verda Kimi (not yet tested live) ---
# From docs.verda.com: the model ID is kimi-k3-1-pro (enable it in the Verda
# project first). Its page lists "JSON mode" but does not mention json_schema,
# and Verda ignores unsupported parameters, so request plain JSON mode; the
# output is still validated against the local schema.
# max_tokens covers reasoning + answer and Kimi defaults to maximum reasoning,
# which can leave the answer empty; non-streaming calls time out after 60 s.
# EXTRACTION_MODEL=kimi-k3-1-pro
# EXTRACTION_RESPONSE_FORMAT=json_object
# EXTRACTION_REASONING_EFFORT=low
# EXTRACTION_MAX_OUTPUT_TOKENS=8192
