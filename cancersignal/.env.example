# Local development only. Copy to .env and choose a local password before startup.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cancersignal
POSTGRES_USER=cancersignal
POSTGRES_PASSWORD=change-me-local-only

# Exact frontend origins, as a JSON array. Restart FastAPI after changing this.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM note extraction in the analysis pipeline (see backend/app/extraction/README.md).
# off = structured-only demo extractor; llm = add LLM note extraction.
CANCERSIGNAL_EXTRACTION=off
# Provider settings (EXTRACTION_MODEL, EXTRACTION_API_KEY, ...) in a separate, Git-ignored file.
# Paths are relative to backend/, where uvicorn runs.
# CANCERSIGNAL_EXTRACTION_ENV_FILE=.env.extraction
# Paid live calls only when explicitly true; otherwise cached responses only.
CANCERSIGNAL_EXTRACTION_ALLOW_LIVE=false
# CANCERSIGNAL_EXTRACTION_CACHE_DIR=.venv/extraction-cache

# Analysis retrieval: auto (complete history while it fits, otherwise lexical),
# lexical (PostgreSQL full text + timeline), hybrid (local embeddings + lexical),
# or baseline (legacy full-history retriever).
CANCERSIGNAL_RETRIEVAL=auto
CANCERSIGNAL_RETRIEVAL_TOP_K=5
CANCERSIGNAL_RETRIEVAL_MAX_SOURCE_CHARS=32000
# Hybrid refreshes eligible new/changed sources before each analysis.
CANCERSIGNAL_RETRIEVAL_AUTO_INDEX=true
# Defaults to the running interpreter's rag-model-cache under its virtualenv.
# CANCERSIGNAL_RETRIEVAL_MODEL_CACHE=.venv/rag-model-cache
